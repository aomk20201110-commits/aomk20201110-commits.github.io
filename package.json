{
  "name": "yurripe-academic-home",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal academic site of Yurripe — electromagnetics, metasurfaces and scientific computing.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:ssr && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .cache/ssr --emptyOutDir",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "tsc -b",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "cv:pdf": "node scripts/generate-cv.mjs",
    "og:image": "node scripts/generate-og.mjs",
    "shots": "node scripts/screenshot.mjs",
    "qa": "node scripts/qa.mjs",
    "test:models": "node scripts/test-models.mjs",
    "test:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "i18next": "^27.2.9",
    "katex": "^0.19.1",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.7",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
